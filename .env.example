# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/boutique

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (emails de confirmation)
RESEND_API_KEY=re_...

# Brevo (SMS admin)
BREVO_API_KEY=xkeysib-...
ADMIN_PHONE=+33600000000

# Marque & frontend
BRAND_NAME=Nom de la boutique
BRAND_FOUNDER=L'équipe
FRONTEND_URL=https://nomboutique.fr
NEXT_PUBLIC_SITE_URL=https://nomboutique.fr

# CORS : origines navigateur autorisées, séparées par des virgules
# Vide : localhost autorisé en développement uniquement
ALLOWED_ORIGINS=https://nomboutique.fr,https://www.nomboutique.fr

# Admin (header x-admin-password)
ADMIN_EMAIL=admin@nomboutique.fr
ADMIN_PASSWORD=admin-password-change-me

# Tenant initial (scripts/migrate-tenants.js, API master uniquement)
MASTER_DOMAIN=
MASTER_API_URL=
MASTER_BRAND_NAME=

# Codes promo par défaut
WELCOME_PROMO_CODE=BIENVENUE10
INACTIVE_PROMO_CODE=RETOUR10

# Tests & scripts
TEST_EMAIL=test@example.com

# Google Analytics 4 (Data API)
# Prefer GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or GOOGLE_CREDENTIALS as one-line JSON
# GA4_PROPERTY_ID = numeric id (GA4 Admin → Property settings)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS=
GA4_PROPERTY_ID=

# IndexNow (Bing / Perplexity)
INDEXNOW_KEY=
SITE_URL=https://nomboutique.fr

# Serveur
PORT=3001
