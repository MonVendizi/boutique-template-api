# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/boutique

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (emails de confirmation)
RESEND_API_KEY=re_...

# Brevo (SMS admin)
BREVO_API_KEY=xkeysib-...
ADMIN_PHONE=+33769466294

# Marque & frontend
BRAND_NAME=Ma Boutique
BRAND_FOUNDER=L'équipe
FRONTEND_URL=https://maboutique.fr
NEXT_PUBLIC_SITE_URL=https://maboutique.fr

# Admin (header x-admin-password)
ADMIN_EMAIL=admin@maboutique.fr
ADMIN_PASSWORD=admin-password-change-me

# Codes promo par défaut
WELCOME_PROMO_CODE=BIENVENUE10
INACTIVE_PROMO_CODE=RETOUR10

# Tests & scripts
TEST_EMAIL=test@example.com

# Google Analytics 4 (Data API)
# Prefer GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or GOOGLE_CREDENTIALS as one-line JSON
# GA4_PROPERTY_ID = numeric id (GA4 Admin → Property settings)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS=
GA4_PROPERTY_ID=

# IndexNow (Bing / Perplexity)
INDEXNOW_KEY=
SITE_URL=https://maboutique.fr

# Serveur
PORT=3001
